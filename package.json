{
  "name": "algo-trader",
  "version": "1.0.0",
  "description": "BTC/USD algorithmic trading application with simulated execution engine",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/runBacktest.js",
    "backtest": "ts-node src/cli/runBacktest.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docker:build": "docker build -t algo-trader:latest -f docker/Dockerfile .",
    "docker:run": "docker-compose up --build"
  },
  "keywords": [
    "algorithmic-trading",
    "btc",
    "simulated-broker",
    "backtesting",
    "typescript"
  ],
  "author": "algo-trader",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "decimal.js": "^10.4.3"
  }
}
